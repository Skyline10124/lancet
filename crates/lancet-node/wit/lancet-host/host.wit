package lancet:host@0.1.0;

interface handles {
    record entry { name: string, is-dir: bool, is-link: bool }

    resource read-dir {
        /// 读取目录内 path 处的文本文件（大小不超过 128 MiB 的有效 UTF-8 文本）；跟随目录内相对符号链接，越界时报错；目标不存在（ENOENT）时返回 none。
        read: func(path: string) -> result<option<string>, string>;
        /// 列出目录内 path 处目录的直接子项（按名称 UTF-8 字节序排序）；过滤越界或悬空符号链接与非普通文件/目录，保留指向目录内文件或目录的符号链接；目标不存在（ENOENT）时返回 none。
        entries: func(path: string) -> result<option<list<entry>>, string>;
    }
    resource write-dir {
        /// 读取宿主目录内 path 处的文本文件（大小不超过 128 MiB 的有效 UTF-8 文本）；跟随目录内相对符号链接，越界时报错；目标不存在（ENOENT）时返回 none。
        read: func(path: string) -> result<option<string>, string>;
        /// 将 UTF-8 文本整文件直接写入宿主目录内 path 处，自动创建缺少的上级目录；替换已有普通文件时保持其权限。
        write: func(path: string, content: string) -> result<_, string>;
    }
    resource exec-env;
    resource egress;
}

world tool-host {
    import handles;
}
