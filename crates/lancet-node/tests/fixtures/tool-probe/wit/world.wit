package lancet:tool-probe@0.1.0;

interface probe {
    use lancet:host/handles@0.1.0.{read-dir, write-dir};

    /// 回显收到的各类型参数。
    echo: func(dir: borrow<read-dir>, a: u8, b: s32, c: u64, d: f32, e: list<u8>) -> string;
    /// 误将只读句柄当作可写句柄释放，触发组件陷入。
    misuse: func(dir: borrow<read-dir>);
    /// 分配超过 128 MiB 线性内存，触发内存上限中断。
    grow: func(dir: borrow<read-dir>);
    /// 进入死循环，用于测试截止时间与取消中断。
    spin: func(dir: borrow<read-dir>);
    /// 先写入宿主文件再返回错误，用于验证写入回执与已落盘内容在工具报错时保留。
    write-then-fail: func(dir: borrow<write-dir>, path: string, content: string) -> result<_, string>;
    /// 向第一个可写目录句柄写入文件，用于测试多句柄模板越界核对。
    write-first: func(dst: borrow<write-dir>, other: borrow<write-dir>, path: string, content: string) -> result<_, string>;
}

world tool-probe {
    import lancet:host/handles@0.1.0;
    export probe;
}
